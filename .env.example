# Supabase Configuration
# Get these from: https://app.supabase.com -> Your Project -> Settings -> API
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI Assistant Provider Configuration
# Options: 'ollama' (local), 'gemini' (Google API), 'api' (OpenAI, etc.)
SLM_PROVIDER=ollama

# Ollama Configuration (for local AI assistant)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct

# Gemini Configuration (Google AI)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# API Configuration (for OpenAI, Anthropic, etc.)
API_BASE_URL=
API_KEY=

# Database Configuration
USE_SUPABASE=true
